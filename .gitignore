# Terraform
**/.terraform/
modules/**/.terraform.lock.hcl
# envs lock files ARE committed (make lock): version pins alone don't pin
# artifact hashes; the lock file closes the supply-chain gap at init.
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# statefill temp state copies (recipe uses mktemp, this is the belt)
.statefill.*.json

# Remote-state settings — work-specific values, never committed here
backend.conf

# Saved plan artifacts (make plan SAVE=1) — pipeline artifacts, may
# contain sensitive values; never committed
envs/**/tfplan
.plan-changed.tmp

# validate-imports fixture copy — staged into env roots, removed after;
# ignored as a safety net for interrupted runs (never committed)
envs/**/imports_check.tf

# Apply-chain test throwaway tenant (tools/tests/test_apply_chain.py) —
# created/removed in setUp/teardown; ignored so a hard kill can't leak it
envs/tmpchaintest/
config/tmpchaintest/
config/tmpfmttest/
config/tmptypechktest/
config/tmpdropschk/
config/tmplintadv/
imports/tmpdropschk/

# make install-tf output
bin/

# Rendered drift/plan reports — pipeline artifacts, never committed
reports/

# Workflow gate + operate artifacts (make gate / op-*) -- pipeline scratch,
# may echo tenant-derived values; never committed
outputs/

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Local working docs
docs/superpowers/

# Fetcher output — never commit real pulls
pulls/*
!pulls/README.md
!pulls/.gitkeep

# Operating manual — private environment layer stays out of the public repo
OPERATING.local.md
