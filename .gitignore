# Terraform
**/.terraform/
modules/**/.terraform.lock.hcl
envs/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Remote-state settings — work-specific values, never committed here
backend.conf

# Saved plan artifacts (make plan SAVE=1) — pipeline artifacts, may
# contain sensitive values; never committed
envs/**/tfplan
.plan-changed.tmp

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Local working docs
docs/superpowers/

# Fetcher output — never commit real pulls
pulls/*
!pulls/README.md
!pulls/.gitkeep
