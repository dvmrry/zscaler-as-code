#!/bin/sh
# Fake terraform for Makefile chain tests (make ... TF=tools/tests/bin/fake-tf).
# Speaks just enough of the CLI surface the plan/apply targets use:
#   init  -> ok
#   plan  -> prints a summary; writes tfplan into -chdir when -out=tfplan
#   show  -> emits plan JSON with $FAKE_TF_DESTROYS delete actions
#   apply -> requires tfplan; appends the root to $FAKE_TF_LOG
chdir=""
cmd=""
saved=no
json=no
for arg in "$@"; do
  case "$arg" in
    -chdir=*) chdir="${arg#-chdir=}" ;;
    -out=tfplan) saved=yes ;;
    -json) json=yes ;;
    -*) ;;
    *) [ -z "$cmd" ] && cmd="$arg" ;;
  esac
done
case "$cmd" in
  init)
    exit 0 ;;
  plan)
    echo "Plan: 1 to import, 0 to add, 0 to change, ${FAKE_TF_DESTROYS:-0} to destroy."
    [ "$saved" = yes ] && echo "fake-plan" > "$chdir/tfplan"
    exit 0 ;;
  show)
    if [ "$json" = "no" ]; then
      # human-readable form (plan-report consumes this)
      echo "fake-tf plan for $chdir"
      echo "Plan: 1 to import, 0 to add, 0 to change, ${FAKE_TF_DESTROYS:-0} to destroy."
      exit 0
    fi
    # Parseable JSON lacking resource_changes — simulates a skewed
    # terraform/provider whose show prints an old-format document. The
    # gates must reject this, not read it as "0 changes".
    if [ -n "$FAKE_TF_NORC" ]; then
      printf '{"format_version":"0.1"}'
      exit 0
    fi
    n="${FAKE_TF_DESTROYS:-0}"
    u="${FAKE_TF_UPDATES:-0}"
    i2="${FAKE_TF_IMPORTS:-0}"
    printf '{"resource_changes": [{"change":{"actions":["no-op"]}}'
    j=0
    while [ "$j" -lt "$i2" ]; do
      printf ',{"change":{"actions":["no-op"],"importing":{"id":"x"}}}'
      j=$((j+1))
    done
    i=0
    while [ "$i" -lt "$n" ]; do
      printf ',{"change":{"actions":["delete"]}}'
      i=$((i+1))
    done
    i=0
    while [ "$i" -lt "$u" ]; do
      printf ',{"change":{"actions":["update"]}}'
      i=$((i+1))
    done
    printf ']}'
    exit 0 ;;
  force-unlock)
    [ -n "$FAKE_TF_LOG" ] && echo "force-unlock $*" >> "$FAKE_TF_LOG"
    exit 0 ;;
  state)
    # `state list`: managed addresses from $FAKE_TF_STATE (newline-sep)
    # `state rm <addr>`: logged for assertions
    if [ "$2" = "rm" ] || [ "$3" = "rm" ]; then
      [ -n "$FAKE_TF_LOG" ] && echo "state rm $*" >> "$FAKE_TF_LOG"
      exit 0
    fi
    [ -n "$FAKE_TF_STATE" ] && printf '%s\n' "$FAKE_TF_STATE"
    exit 0 ;;
  apply)
    test -f "$chdir/tfplan" || { echo "fake-tf: no tfplan in $chdir" >&2; exit 1; }
    [ -n "$FAKE_TF_LOG" ] && echo "applied $chdir" >> "$FAKE_TF_LOG"
    exit 0 ;;
  *)
    exit 0 ;;
esac
