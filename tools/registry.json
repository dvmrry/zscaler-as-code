{
  "zpa_application_segment": {
    "product": "zpa",
    "generate": true,
    "fetch": {"path": "application", "pagination": "zpa"}
  },
  "zpa_segment_group": {
    "product": "zpa",
    "generate": true,
    "fetch": {"path": "segmentGroup", "pagination": "zpa"}
  },
  "zpa_server_group": {
    "product": "zpa",
    "generate": true,
    "fetch": {"path": "serverGroup", "pagination": "zpa"}
  },
  "zia_url_categories": {
    "product": "zia",
    "generate": true,
    "fetch": {"path": "urlCategories", "pagination": "zia", "query": {"customOnly": "true"}}
  },
  "zia_location_management": {
    "product": "zia", "generate": true,
    "fetch": {"path": "locations", "pagination": "zia"}
  },
  "zia_ssl_inspection_rules": {
    "product": "zia", "generate": true,
    "fetch": {"path": "sslInspectionRules", "pagination": "zia"}
  },
  "zia_cloud_app_control_rule": {
    "product": "zia", "generate": true,
    "fetch": {
      "path": "webApplicationRules/{rule_type}", "pagination": "zia",
      "expand": {"rule_type": [
        "AI_ML", "BUSINESS_PRODUCTIVITY", "CONSUMER", "DNS_OVER_HTTPS",
        "ENTERPRISE_COLLABORATION", "FILE_SHARE", "FINANCE", "HOSTING_PROVIDER",
        "INSTANT_MESSAGING", "IT_SERVICES", "SOCIAL_NETWORKING",
        "STREAMING_MEDIA", "SYSTEM_AND_DEVELOPMENT", "WEBMAIL"
      ]}
    }
  },
  "zia_url_filtering_rules": {
    "product": "zia", "generate": true,
    "fetch": {"path": "urlFilteringRules", "pagination": "zia"}
  },
  "zia_rule_labels": {
    "product": "zia", "generate": true,
    "fetch": {"path": "ruleLabels", "pagination": "zia"}
  },
  "zpa_app_connector_group": {
    "product": "zpa", "generate": true,
    "fetch": {"path": "appConnectorGroup", "pagination": "zpa"}
  },
  "zpa_application_server": {
    "product": "zpa", "generate": true,
    "fetch": {"path": "server", "pagination": "zpa"}
  }
}
